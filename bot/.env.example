BOT_PORT=3010
NODE_ENV=production

# MySQL compartilhado com a API principal
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL=false
# Alternativa opcional:
# DATABASE_URL=mysql://usuario:senha@host:3306/banco

# Deve ser o mesmo JWT_SECRET do backend principal para validar o painel
JWT_SECRET=

# Protege chamadas internas feitas pela API principal
BOT_SERVICE_TOKEN=

# Reconciliacao: bot puxa mudancas da API principal quando volta de queda
BACKEND_API_URL=https://api.ocortecerto.com/api
BOT_BACKEND_SYNC_ENABLED=true
BOT_BACKEND_SYNC_INTERVAL_MS=60000
BOT_BACKEND_SYNC_LIMIT=200
BOT_BACKEND_SYNC_OVERLAP_MINUTES=5
BOT_BACKEND_SYNC_TIMEOUT_MS=15000
BOT_BACKEND_SYNC_STATE_PATH=.bot_sync_state.json

# Origem do frontend/painel
APP_URL=https://ocortecerto.com
CORS_ORIGIN=https://ocortecerto.com,https://www.ocortecerto.com,https://api.ocortecerto.com

# Redis local do LXC
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Sessões locais do Baileys na VPS
BOT_AUTH_DATA_PATH=.baileys_auth
BOT_WORKER_ID=worker-a
BOT_MAX_SESSIONS=40

# Filas e comportamento de envio
BOT_SEND_DELAY_MIN_MS=800
BOT_SEND_DELAY_MAX_MS=2500
BOT_INBOUND_CONCURRENCY=5
BOT_OUTBOUND_CONCURRENCY=3
BOT_SESSION_CONCURRENCY=2
BOT_SCHEDULER_INTERVAL_MS=60000
BOT_STALE_SESSION_MINUTES=180
BOT_QR_TTL_MS=120000
BOT_CONNECTION_STALE_MS=90000
BOT_MAX_RECONNECT_ATTEMPTS=3
