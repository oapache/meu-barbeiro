PORT=3001
NODE_ENV=development

# MySQL 8 (Docker local / Hostinger)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=meu_barbeiro_test
MYSQL_SSL=false
MYSQL_CONNECTION_LIMIT=5
MYSQL_QUEUE_LIMIT=100
# Alternativa opcional:
# DATABASE_URL=mysql://root:root@127.0.0.1:3307/meu_barbeiro_test

# JWT
JWT_SECRET=meubarbeiro-secret-key

# Supabase (opcional para outros recursos)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# URLs públicas
APP_URL=https://ocortecerto.com
API_PUBLIC_URL=https://api.ocortecerto.com
CORS_ORIGIN=https://ocortecerto.com,https://www.ocortecerto.com,http://localhost:3000

# Serviço separado do ChatBot/WhatsApp (rodando na VPS)
BOT_SERVICE_URL=
BOT_SERVICE_TOKEN=
BOT_SERVICE_TIMEOUT_MS=5000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe prices by professional range
STRIPE_PRICE_ID_1_PRO=
STRIPE_PRICE_ID_2_5_PRO=
STRIPE_PRICE_ID_6_15_PRO=
STRIPE_PRICE_ID_15_PLUS_PRO=

# Optional one-cycle promo coupons by range
STRIPE_PROMO_COUPON_1_PRO=
STRIPE_PROMO_COUPON_2_5_PRO=
STRIPE_PROMO_COUPON_6_15_PRO=
STRIPE_PROMO_COUPON_15_PLUS_PRO=
